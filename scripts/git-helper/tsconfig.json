{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./types", "../../node_modules/@types"]
  },
  "include": ["./**/*.ts", "./types/**/*.d.ts"]
}
